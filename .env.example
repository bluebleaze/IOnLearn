# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: Default AI Provider configuration (gemini or openai)
AI_PROVIDER=gemini
NEXT_PUBLIC_GEMINI_MODEL="gemini-3.5-flash-lite" #only when using gemini

# Optional: Required if AI_PROVIDER=openai
OPENAI_API_KEY="your_openai_api_key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-3.5-turbo"

# Branding & App Information (used for browser tabs, header, modals)
NEXT_PUBLIC_APP_NAME="IOnLearn"
NEXT_PUBLIC_APP_TAGLINE="Produktivitas Akademik & Asisten Belajar"

# Firebase Client Configuration (Required for Google Auth & Cloud Firestore)
# Option 1: Set individual variables (Recommended on Vercel)
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
NEXT_PUBLIC_FIREBASE_OAUTH_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_FIREBASE_RECAPTCHA_SITE_KEY=""

# Option 2 (Alternative): Paste complete JSON string in one single variable
# NEXT_PUBLIC_FIREBASE_CONFIG='{"projectId":"your-project-id","appId":"...","apiKey":"...","authDomain":"...","storageBucket":"...","messagingSenderId":"..."}'
